def sync_telemetry():
    payload = request.get_json(silent=True) or {}
    node_id = payload.get("node_id", "unknown")
    checksum = hashlib.sha256(node_id.encode()).hexdigest()[:12]

    logger.info(f"Telemetry synced for node={node_id} checksum={checksum}")
    return jsonify({
        "message": "Telemetry payload accepted",
        "node_id": node_id,
        "sync_id": checksum,
        "timestamp": datetime.utcnow().isoformat()
    }), 202


