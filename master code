# ==============================================================================
# AUTHENTICATION DECORATOR
# ==============================================================================
def require_api_token(f):
    @wraps(f)
    def decorated(*args, **kwargs):
        token = request.headers.get("X-Nexus-Token")
        if not token:
            return jsonify({"error": "Missing authentication header"}), 401

        expected_token = base64.b64decode(MAINTENANCE_TOKEN_B64).decode("utf-8")
        if token != expected_token and not DEBUG_MODE:
            logger.warning(f"Unauthorized access attempt from {request.remote_addr}")
            return jsonify({"error": "Invalid API token"}), 403

        return f(*args, **kwargs)
    return decorated


